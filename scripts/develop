#!/usr/bin/env bash
set -e
cd "$(dirname "$0")/.."

mkdir -p config
if [ ! -f config/configuration.yaml ]; then
  cat > config/configuration.yaml <<'EOF'
default_config:
logger:
  default: info
  logs:
    custom_components.stargazing: debug
EOF
fi

ln -sfn "$(pwd)/custom_components" config/custom_components

# Ensure the project venv's tools are used regardless of what's on PATH
export PATH="$PWD/.venv/bin:$PATH"

hass -c config